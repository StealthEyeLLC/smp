[Unit]
Description=SMP one-shot machine initialization
DefaultDependencies=no
After=local-fs-pre.target systemd-remount-fs.service
Before=network-pre.target ssh.service
Wants=network-pre.target
ConditionPathExists=!/var/lib/smp-seed/complete

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/smp-seed-init
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
