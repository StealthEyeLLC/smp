[Unit]
Description=SMP one-shot machine initialization
After=local-fs.target systemd-tmpfiles-setup.service
Before=network-pre.target systemd-networkd.service ssh.service
Wants=network-pre.target
ConditionPathExists=!/var/lib/smp-seed/complete

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/smp-seed-init
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
