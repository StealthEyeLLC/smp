{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/StealthEyeLLC/smp/plugin/smp.go.schema.json",
  "title": "smp.go",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "operation"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "machine": {
      "type": ["string", "null"]
    },
    "argv": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 4096,
      "default": []
    },
    "stdin": {
      "type": ["string", "null"],
      "default": null
    },
    "timeoutSeconds": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 86400,
      "default": 300
    },
    "outputLimitBytes": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 67108864,
      "default": 1048576
    },
    "detach": {
      "type": "boolean",
      "default": false
    },
    "options": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  }
}
