{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smp.stealtheye.invalid/schemas/go-request-v1.json",
  "title": "smp.go request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "operation"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "machine": {
      "type": [
        "string",
        "null"
      ]
    },
    "argv": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "stdin": {
      "type": [
        "string",
        "null"
      ],
      "description": "Base64-encoded bytes"
    },
    "timeoutSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 86400
    },
    "outputLimitBytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 67108864
    },
    "detach": {
      "type": "boolean",
      "default": false
    },
    "options": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  }
}
